        position: 49.54, 259.0
        size: 46, 78, 46
      }
      style {
        fill: "#2E3480"
      }
    }

    Isometric crown_5 : flat {
      layout {
        position: 49.54, 256.0
        size: 46, 3, 46
      }
      style {
        fill: "#06D6A0"
      }
    }

    Repeat lights_5_right {
      columns: 4
      rows: 4
      origin: 34, 8
      step: 10, 14
      seed: 35
      chance: 0.55

      Isometric window_5r : flat {
        layout {
          position: 150 + (6 - x - 6) * 0.866, 342 + (6 + x) * 0.5 - 8 - y
          size: 1, 8, 6
        }
        style {
          fill: pick("#FFD166", "#FFD166", "#FFD166", "#EF476F", "#06D6A0")
        }
      }
    }

    Repeat lights_5_left {
      columns: 4
      rows: 4
      origin: -36, 8
      step: 10, 14
      seed: 55
      chance: 0.45

      Isometric window_5l : flat {
        layout {
          position: 150 + (x - 76 - 1) * 0.866, 342 + (x + 76) * 0.5 - 8 - y
          size: 6, 8, 1
        }
        style {
          fill: pick("#FFD166", "#FFD166", "#EF476F")
        }
      }
    }

    Isometric tower_6 : flat {
      layout {
        position: 106.7, 327.0
        size: 40, 50, 40
      }
      style {
        fill: "#22265C"
      }
    }

    Isometric crown_6 : flat {
      layout {
        position: 106.7, 324.0
        size: 40, 3, 40
      }
      style {
        fill: "#EF476F"
      }
    }

    Repeat lights_6_right {
      columns: 3
      rows: 2
      origin: 44, 8
      step: 10, 14
      seed: 42
      chance: 0.55

      Isometric window_6r : flat {
        layout {
          position: 150 + (70 - x - 6) * 0.866, 342 + (70 + x) * 0.5 - 8 - y
