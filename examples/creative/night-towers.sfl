        size: 50, 3, 50
      }
      style {
        fill: "#EF476F"
      }
    }

    Repeat lights_4_right {
      columns: 4
      rows: 5
      origin: -36, 8
      step: 10, 14
      seed: 28
      chance: 0.55

      Isometric window_4r : flat {
        layout {
          position: 150 + (90 - x - 6) * 0.866, 342 + (90 + x) * 0.5 - 8 - y
          size: 1, 8, 6
        }
        style {
          fill: pick("#FFD166", "#FFD166", "#FFD166", "#EF476F", "#06D6A0")
        }
      }
    }

    Repeat lights_4_left {
      columns: 4
      rows: 5
      origin: 44, 8
      step: 10, 14
      seed: 44
      chance: 0.45

      Isometric window_4l : flat {
        layout {
          position: 150 + (x - 10 - 1) * 0.866, 342 + (x + 10) * 0.5 - 8 - y
