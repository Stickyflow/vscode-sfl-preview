sfl 1.6

// Night Towers: glass towers whose lit windows are drawn by Repeat blocks,
// in the palette Neon Night.

Style flat { stroke: none; seams: false; cornerRadius: 0; shadow: false }

Model night_towers {
  Container paper {
    kind: frame
    layout {
      position: 0, 0
      size: 300, 400
    }
    style {
      fill: "#0E1033"
      stroke: none
      cornerRadius: 0
      showLabel: false
      shadow: false
      clip: true
    }

    Isometric plaza : flat {
      layout {
        position: -40.52, 232.0
        size: 220, 4, 220
      }
      style {
        fill: "#181B47"
      }
    }

    Isometric tower_1 : flat {
      layout {
        position: 106.7, 76.0
        size: 50, 176, 50
      }
      style {
        fill: "#2E3480"
      }
    }

    Isometric crown_1 : flat {
      layout {
        position: 106.7, 73.0
        size: 50, 3, 50
      }
      style {
        fill: "#06D6A0"
      }
    }

    Repeat lights_1_right {
      columns: 4
      rows: 11
      origin: -86, 8
      step: 10, 14
      seed: 7
      chance: 0.55

      Isometric window_1r : flat {
        layout {
          position: 150 + (-40 - x - 6) * 0.866, 342 + (-40 + x) * 0.5 - 8 - y
          size: 1, 8, 6
        }
        style {
          fill: pick("#FFD166", "#FFD166", "#FFD166", "#EF476F", "#06D6A0")
        }
      }
    }

    Repeat lights_1_left {
      columns: 4
      rows: 11
      origin: -86, 8
      step: 10, 14
      seed: 11
      chance: 0.45

      Isometric window_1l : flat {
        layout {
          position: 150 + (x - -40 - 1) * 0.866, 342 + (x + -40) * 0.5 - 8 - y
          size: 6, 8, 1
        }
        style {
          fill: pick("#FFD166", "#FFD166", "#EF476F")
        }
      }
    }

    Isometric tower_2 : flat {
      layout {
        position: 181.18, 148.0
        size: 44, 134, 44
      }
      style {
        fill: "#22265C"
      }
    }

    Isometric crown_2 : flat {
      layout {
        position: 181.18, 145.0
        size: 44, 3, 44
      }
      style {
        fill: "#EF476F"
      }
    }

    Repeat lights_2_right {
      columns: 3
      rows: 8
      origin: -96, 8
      step: 10, 14
      seed: 14
      chance: 0.55

      Isometric window_2r : flat {
        layout {
          position: 150 + (24 - x - 6) * 0.866, 342 + (24 + x) * 0.5 - 8 - y
          size: 1, 8, 6
        }
        style {
          fill: pick("#FFD166", "#FFD166", "#FFD166", "#EF476F", "#06D6A0")
        }
      }
    }

    Repeat lights_2_left {
      columns: 3
      rows: 8
      origin: -16, 8
      step: 10, 14
      seed: 22
      chance: 0.45

      Isometric window_2l : flat {
        layout {
          position: 150 + (x - -56 - 1) * 0.866, 342 + (x + -56) * 0.5 - 8 - y
          size: 6, 8, 1
        }
        style {
          fill: pick("#FFD166", "#FFD166", "#EF476F")
        }
      }
    }

    Isometric tower_3 : flat {
      layout {
        position: 42.62, 162.0
        size: 44, 120, 44
      }
      style {
        fill: "#22265C"
      }
    }

    Isometric crown_3 : flat {
      layout {
        position: 42.62, 159.0
        size: 44, 3, 44
      }
      style {
        fill: "#06D6A0"
      }
    }

    Repeat lights_3_right {
      columns: 3
      rows: 7
      origin: -16, 8
      step: 10, 14
      seed: 21
      chance: 0.55

      Isometric window_3r : flat {
        layout {
          position: 150 + (-56 - x - 6) * 0.866, 342 + (-56 + x) * 0.5 - 8 - y
