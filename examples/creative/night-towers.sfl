          fill: pick("#FFD166", "#FFD166", "#FFD166", "#EF476F", "#06D6A0")
        }
      }
    }

    Repeat lights_3_left {
      columns: 3
      rows: 7
      origin: -96, 8
      step: 10, 14
      seed: 33
      chance: 0.45

