          size: 6, 8, 1
        }
        style {
          fill: pick("#FFD166", "#FFD166", "#EF476F")
        }
      }
    }

    Text title {
      text: "Neon Night"
      layout {
        position: 24, 26
        size: 252, 36
      }
      style {
        textColor: "#FFFFFF"
        fontSize: 30
        fontWeight: 800
        textAlign: left
      }
    }

    Text caption {
      text: "Every lit window is a Repeat"
      layout {
        position: 24, 62
        size: 252, 20
      }
      style {
        textColor: "#A9B0FF"
        fontSize: 12
        fontWeight: 500
        textAlign: left
      }
    }

    Shape swatch_1 {
      text: ""
      layout {
        position: 24, 372
        size: 10, 10
      }
      style {
        shape: circle
        fill: "#22265C"
        stroke: none
      }
    }

    Shape swatch_2 {
      text: ""
      layout {
        position: 40, 372
        size: 10, 10
      }
      style {
        shape: circle
        fill: "#2E3480"
        stroke: none
      }
    }

    Shape swatch_3 {
      text: ""
      layout {
        position: 56, 372
