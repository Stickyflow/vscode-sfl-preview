sfl 1.5

// Layers of colored glass, mixed by multiplying.
// Style Definition

// Style Definition
Style layer { shape: rounded_rectangle; stroke: none }

Model poster {
  Shape paper {
    layout {
      position: 0, 0
      size: 320, 430
    }
    style {
      shape: rectangle
      fill: "#e7ebcd"
      stroke: none
    }
  }

  Shape warm1 : layer {
    layout {
      position: 35, 76
      size: 250, 250
    }
    style {
      fill: "#fbe39a"
      cornerRadius: 115
      opacity: 0.5
      blend: multiply
    }
  }

  Shape warm2 : layer {
    layout {
      position: 43, 96
      size: 234, 215
    }
    style {
      fill: "#f9c96b"
      cornerRadius: 98.9
      opacity: 0.42
      blend: multiply
    }
  }

  Shape warm3 : layer {
    layout {
      position: 50, 116
      size: 220, 190
    }
    style {
      fill: "#f59a3c"
      cornerRadius: 87.4
      opacity: 0.4
      blend: multiply
    }
  }

  Shape warm4 : layer {
    layout {
