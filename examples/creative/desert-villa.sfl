sfl 1.6

// Desert Villa: a flat-roofed modernist house with a pool and two palms,
// in the palette Palm Springs.

Style flat { stroke: none; seams: false; cornerRadius: 0; shadow: false }

Model desert_villa {
  Container paper {
    kind: frame
    layout {
      position: 0, 0
      size: 300, 400
    }
    style {
      fill: "#F4E3C8"
      stroke: none
      cornerRadius: 0
      showLabel: false
      shadow: false
      clip: true
    }

    Isometric lot : flat {
      layout {
        position: -40.52, 90.0
        size: 220, 4, 200
      }
      style {
        fill: "#E9D2AE"
      }
    }

    Isometric terrace : flat {
      layout {
        position: -14.54, 131.0
        size: 150, 4, 100
      }
      style {
        fill: "#F7EEDD"
      }
    }

    Isometric pool : flat {
      layout {
        position: 11.44, 160.0
        size: 90, 5, 50
      }
      style {
        fill: "#2AB3A6"
      }
    }

    Isometric wing : flat {
      layout {
        position: 89.38, 59.0
        size: 80, 46, 60
      }
      style {
        fill: "#FFFDF7"
      }
    }

    Isometric glass : flat {
