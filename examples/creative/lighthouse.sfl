sfl 1.6

// Lighthouse: a striped tower of extruded octagons on the rocks,
// in the palette Nordic Coast.

Style flat { stroke: none; seams: false; cornerRadius: 0; shadow: false }

Symbol Octagon {
  points: [[0.962, 0.691], [0.691, 0.962], [0.309, 0.962], [0.038, 0.691], [0.038, 0.309], [0.309, 0.038], [0.691, 0.038], [0.962, 0.309]]
}

Model lighthouse {
  Container paper {
    kind: frame
    layout {
      position: 0, 0
      size: 300, 400
    }
    style {
      fill: "#DCE8EE"
      stroke: none
      cornerRadius: 0
      showLabel: false
      shadow: false
      clip: true
    }

    Isometric sea : flat {
      layout {
        position: -109.8, 160.0
        size: 300, 4, 300
      }
      style {
        fill: "#8DB3C7"
      }
    }

    Isometric rock {
      layout {
        position: 73.79, 252.0
        size: 60, 18, 48
      }
      style {
        fill: "#5B6770"
        stroke: none
        seams: false
        cornerRadius: 10
      }
    }

    Isometric rock_2 {
      layout {
        position: 156.06, 259.0
        size: 54, 16, 43
      }
      style {
        fill: "#6E7B85"
        stroke: none
        seams: false
        cornerRadius: 10
      }
    }

    Isometric rock_3 {
      layout {
