      }
      style {
        fill: "#F2B134"
      }
    }

    Isometric cap : flat {
      symbol: Octagon
      layout {
        position: 122.29, 90.0
        size: 32, 4, 32
      }
      style {
        fill: "#1D3557"
      }
    }

    Isometric dome {
      layout {
        position: 129.22, 80.0
        size: 24, 20, 24
      }
      style {
        fill: "#C8102E"
