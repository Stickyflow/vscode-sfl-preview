        size: 40, 12, 32
      }
      style {
        fill: "#6E7B85"
        stroke: none
        seams: false
        cornerRadius: 10
      }
    }

    Isometric rock_5 {
      layout {
        position: 161.26, 300.0
        size: 34, 10, 27
      }
      style {
        fill: "#5B6770"
        stroke: none
        seams: false
        cornerRadius: 10
      }
    }

    Isometric base : flat {
      symbol: Octagon
      layout {
        position: 104.97, 264.0
        size: 52, 14, 52
      }
      style {
        fill: "#8A949B"
      }
    }

    Isometric band : flat {
      symbol: Octagon
      layout {
        position: 111.9, 242.0
        size: 44, 26, 44
      }
      style {
        fill: "#C8102E"
      }
    }

    Isometric band_2 : flat {
      symbol: Octagon
      layout {
        position: 114.49, 217.5
        size: 41, 26, 41
      }
      style {
        fill: "#F4F1EA"
      }
    }

    Isometric band_3 : flat {
      symbol: Octagon
      layout {
        position: 117.09, 193.0
        size: 38, 26, 38
      }
      style {
        fill: "#C8102E"
      }
    }

    Isometric band_4 : flat {
      symbol: Octagon
      layout {
        position: 119.69, 168.5
        size: 35, 26, 35
      }
      style {
        fill: "#F4F1EA"
      }
    }

    Isometric band_5 : flat {
      symbol: Octagon
      layout {
        position: 122.29, 144.0
        size: 32, 26, 32
      }
      style {
        fill: "#C8102E"
      }
    }

    Isometric band_6 : flat {
      symbol: Octagon
      layout {
        position: 124.89, 119.5
        size: 29, 26, 29
      }
