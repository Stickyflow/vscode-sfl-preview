    Text title {
      text: "Burano"
      layout {
        position: 24, 300
        size: 252, 40
      }
      style {
        textColor: "#3D3A4B"
        fontSize: 34
        fontWeight: 800
        textAlign: left
      }
    }

    Text caption {
      text: "Seven houses, five colours"
      layout {
        position: 24, 340
        size: 252, 20
      }
      style {
        textColor: "#3D3A4B"
        fontSize: 12
        fontWeight: 500
        textAlign: left
      }
    }

    Shape swatch_1 {
