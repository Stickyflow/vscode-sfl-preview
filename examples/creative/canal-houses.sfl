sfl 1.6

// Canal Houses: a row of narrow painted houses on the water,
// in the palette Burano.

Style flat { stroke: none; seams: false; cornerRadius: 0; shadow: false }

Model canal_houses {
  Container paper {
    kind: frame
    layout {
      position: 0, 0
      size: 300, 400
    }
    style {
      fill: "#FFF4E6"
      stroke: none
      cornerRadius: 0
      showLabel: false
      shadow: false
      clip: true
    }

    Isometric water : flat {
      layout {
        position: -94.8, 156.0
        size: 240, 4, 140
      }
      style {
        fill: "#9CC9E3"
      }
    }

    Isometric quay : flat {
      layout {
        position: 26.44, 141.0
        size: 240, 6, 18
      }
      style {
        fill: "#E8DCC8"
      }
    }

    Isometric house : flat {
      layout {
        position: 48.96, 40.0
        size: 32, 84, 42
      }
      style {
        fill: "#F28C8C"
      }
    }

    Isometric cornice : flat {
      layout {
        position: 48.96, 36.0
        size: 32, 4, 42
      }
      style {
        fill: "#FFFFFF"
      }
    }

    Isometric house_2 : flat {
      layout {
        position: 76.67, 32.0
        size: 32, 108, 42
      }
      style {
        fill: "#F6CF65"
      }
    }

    Isometric cornice_2 : flat {
      layout {
        position: 76.67, 28.0
        size: 32, 4, 42
      }
      style {
        fill: "#FFFFFF"
      }
    }

    Isometric house_3 : flat {
