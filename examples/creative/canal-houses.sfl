        position: 104.38, 82.0
        size: 32, 74, 42
      }
      style {
        fill: "#7FC8A9"
      }
    }

    Isometric cornice_3 : flat {
      layout {
        position: 104.38, 78.0
        size: 32, 4, 42
      }
      style {
        fill: "#FFFFFF"
      }
    }

    Isometric house_4 : flat {
      layout {
        position: 132.09, 54.0
        size: 32, 118, 42
      }
      style {
        fill: "#6CA0DC"
      }
    }

    Isometric cornice_4 : flat {
      layout {
        position: 132.09, 50.0
        size: 32, 4, 42
      }
      style {
        fill: "#FFFFFF"
      }
