      }
    }

    Isometric boat : flat {
      layout {
        position: 17.78, 182.0
        size: 30, 4, 10
      }
      style {
        fill: "#F28C8C"
      }
    }

    Isometric boat_2 : flat {
      layout {
        position: 38.56, 216.0
        size: 30, 4, 10
      }
      style {
        fill: "#7FC8A9"
      }
