      style {
        fill: "#F6CF65"
      }
    }

    Isometric cornice_6 : flat {
      layout {
        position: 187.52, 120.0
        size: 32, 4, 42
      }
      style {
        fill: "#FFFFFF"
      }
    }

    Isometric house_7 : flat {
      layout {
        position: 215.23, 116.0
        size: 32, 104, 42
      }
      style {
        fill: "#F28C8C"
      }
    }

    Isometric cornice_7 : flat {
      layout {
        position: 215.23, 112.0
        size: 32, 4, 42
      }
      style {
        fill: "#FFFFFF"
      }
    }

    Repeat windows_1 {
      columns: 2
      rows: 2
      origin: -105, 24
      step: 11, 26

      Isometric window_1 : flat {
        layout {
          position: 165 + (x - 23) * 0.866, 196 + (x + 22) * 0.5 - 12 - y
          size: 7, 12, 1
        }
        style {
          fill: "#FFFFFF"
        }
      }
    }

    Isometric door : flat {
      layout {
        position: 57.62, 134.5
        size: 10, 16, 1
      }
      style {
