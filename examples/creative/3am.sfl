sfl 1.4

// 3AM in Shibuya: a skyline under the moon, in the page palette.

Model poster {
  Shape sky {
    layout {
      position: 0, 0
      size: 320, 440
    }
    style {
      shape: rectangle
      fill: "gradient(90, #02030A 0%, #012D55 62%, #2B5378 100%)"
      stroke: none
    }
  }

  Shape starA {
    layout {
      position: 40, 150
      size: 3, 3
    }
    style {
      shape: circle
      fill: "#A1CDF8"
      stroke: none
      opacity: 0.7
    }
  }

  Shape starB {
    layout {
      position: 150, 120
      size: 2, 2
    }
    style {
      shape: circle
      fill: "#A1CDF8"
      stroke: none
      opacity: 0.5
    }
  }

  Shape starC {
    layout {
      position: 290, 170
      size: 3, 3
    }
    style {
      shape: circle
      fill: "#A1CDF8"
      stroke: none
      opacity: 0.6
    }
  }

  Shape moon {
    layout {
      position: 196, 44
      size: 84, 84
    }
    style {
      shape: circle
      fill: "#A1CDF8"
      stroke: none
      shadow: "shadow(color:#A1CDF8, opacity:0.55, blur:40)"
    }
  }

  Shape towerA {
