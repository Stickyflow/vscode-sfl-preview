// Webview client modules — browser ES modules that run INSIDE the preview
// webview, NOT part of the extension-host build (tsconfig.json). Emitted to
// media/webview/ (git-ignored, like media/stickyflow/). See webview/README.md.
{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "outDir": "media/webview",
    "rootDir": "webview",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["webview/**/*.ts"],
  "exclude": ["webview/__tests__/**"]
}
