{
  "name": "vscode-sfl-preview",
  "displayName": "StickyFlow SFL Preview",
  "description": "See your SFL diagrams live next to the code, and edit them right on the canvas.",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "icon": "icons/icon.png",
  "publisher": "StickyFlowLab",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stickyflow/vscode-sfl-preview.git"
  },
  "bugs": {
    "url": "https://github.com/Stickyflow/vscode-sfl-preview/issues"
  },
  "homepage": "https://github.com/Stickyflow/vscode-sfl-preview#readme",
  "keywords": [
    "sfl",
    "sticky flow",
    "preview",
    "diagram",
    "visualization"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:sfl"
  ],
  "extensionDependencies": [
    "StickyFlowLab.vscode-sfl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sfl.showPreview",
        "title": "SFL: Open Preview",
        "category": "SFL",
        "icon": "$(open-preview)"
      },
      {
        "command": "sfl.showPreviewToSide",
        "title": "SFL: Open Preview to the Side",
        "category": "SFL",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sfl.showPreview",
          "when": "resourceLangId == sfl",
          "group": "navigation@10"
        },
        {
          "command": "sfl.showPreviewToSide",
          "when": "resourceLangId == sfl",
          "group": "navigation@11"
        }
      ],
      "editor/title": [
        {
          "command": "sfl.showPreviewToSide",
          "when": "editorLangId == sfl",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "sfl.showPreview",
          "when": "editorLangId == sfl"
        },
        {
          "command": "sfl.showPreviewToSide",
          "when": "editorLangId == sfl"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "copy-media": "node ./scripts/copy-media.mjs",
    "compile:webview": "node -e \"require('fs').rmSync('media/webview', { recursive: true, force: true })\" && tsc -p ./tsconfig.webview.json",
    "compile": "npm run copy-media && tsc -p ./ && npm run compile:webview",
    "watch": "npm run copy-media && npm run compile:webview && tsc -p ./ --watch",
    "watch:webview": "tsc -p ./tsconfig.webview.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:webview": "node ./scripts/verify-webview.mjs",
    "check": "npm run compile && npm test && npm run verify:webview",
    "package": "vsce package"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "stickyflow": "0.12.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
